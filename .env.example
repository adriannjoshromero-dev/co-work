# Supabase PostgreSQL connection string.
# Local development/migrations: copy the Session pooler URL (port 5432).
# Vercel production: set DATABASE_URL to the Transaction pooler URL (port 6543).
# Always copy the exact host from Supabase's Connect dialog; do not guess the pooler index.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-INDEX-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# UploadThing dashboard token (contains app id and secret).
UPLOADTHING_TOKEN=

# Seed-only credentials. Change these before running the seed in a shared environment.
SEED_COORDINATOR_USERNAME=coordinator
SEED_COORDINATOR_PASSWORD=ChangeMe-Coordinator-2026!
SEED_INTERVIEWER_USERNAME=interviewer
SEED_INTERVIEWER_PASSWORD=ChangeMe-Interviewer-2026!
